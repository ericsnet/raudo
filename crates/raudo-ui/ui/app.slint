// Raudo — shell layout: tab strip, navigation bar, sidebar, home and list.

import { ListView, ScrollView } from "std-widgets.slint";

global Icons {
    out property <image> folder: @image-url("../assets/icons/folder.svg");
    out property <image> file: @image-url("../assets/icons/file.svg");
    out property <image> exe: @image-url("../assets/icons/exe.svg");
    out property <image> image: @image-url("../assets/icons/image.svg");
    out property <image> audio: @image-url("../assets/icons/audio.svg");
    out property <image> video: @image-url("../assets/icons/video.svg");
    out property <image> archive: @image-url("../assets/icons/archive.svg");
    out property <image> code: @image-url("../assets/icons/code.svg");
    out property <image> drive: @image-url("../assets/icons/drive.svg");
    out property <image> home: @image-url("../assets/icons/home.svg");
    out property <image> download: @image-url("../assets/icons/download.svg");
    out property <image> document: @image-url("../assets/icons/document.svg");
    out property <image> refresh: @image-url("../assets/icons/refresh.svg");
    out property <image> expand: @image-url("../assets/icons/expand.svg");
    out property <image> plus: @image-url("../assets/icons/plus.svg");
    out property <image> pencil: @image-url("../assets/icons/pencil.svg");
    out property <image> copy: @image-url("../assets/icons/copy.svg");
    out property <image> trash: @image-url("../assets/icons/trash.svg");
    out property <image> chevron: @image-url("../assets/icons/chevron.svg");
    out property <image> sort: @image-url("../assets/icons/sort.svg");
    out property <image> list: @image-url("../assets/icons/list.svg");
}

component KindIcon inherits Image {
    in property <string> kind;
    width: 18px;
    height: 18px;
    image-fit: contain;
    source: kind == "folder" ? Icons.folder
        : kind == "drive" ? Icons.drive
        : kind == "home" ? Icons.home
        : kind == "download" ? Icons.download
        : kind == "document" ? Icons.document
        : kind == "image" ? Icons.image
        : kind == "audio" ? Icons.audio
        : kind == "video" ? Icons.video
        : kind == "archive" ? Icons.archive
        : kind == "code" ? Icons.code
        : kind == "exe" ? Icons.exe
        : Icons.file;
}

export struct Row {
    name: string,
    meta: string,
    date: string,
    type-text: string,
    label-text: string,
    state-text: string,
    is-dir: bool,
    path: string,
    kind: string,
}

export struct Crumb {
    name: string,
    value: string,
}

export struct TabItem {
    title: string,
}

export struct Drive {
    letter: string,
    label: string,
    detail: string,
    usage: float,
    root: string,
}

export struct NavItem {
    label: string,
    path: string,
    kind: string,
}

component ToolButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> enabled: true;
    callback clicked();

    width: 30px;
    height: 28px;
    border-radius: 6px;
    background: enabled && touch.has-hover ? #2f343b : transparent;

    KindIcon {
        kind: "";
        source: root.icon;
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        opacity: root.enabled ? 1 : 0.4;
        visible: root.has-icon;
    }

    Text {
        text: root.label;
        color: root.enabled ? #d6dbe1 : #5a6068;
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
        visible: !root.has-icon;
    }

    touch := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

component NavEntry inherits Rectangle {
    in property <string> label;
    in property <string> kind;
    in property <bool> active;
    callback clicked();

    height: 30px;
    border-radius: 6px;
    background: touch.has-hover ? #2a2f36 : (root.active ? #2d3542 : transparent);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;

        Rectangle {
            width: 3px;
            height: 14px;
            border-radius: 2px;
            background: root.active ? #5b9dff : transparent;
        }

        Rectangle {
            width: 16px;
            background: transparent;

            KindIcon {
                kind: root.kind;
                width: 16px;
                height: 16px;
            }
        }

        Text {
            text: root.label;            color: root.active ? #eef1f5 : #c2c8cf;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SectionLabel inherits Text {
    color: #7d848c;
    font-size: 11px;
    letter-spacing: 0.6px;
    height: 26px;
    vertical-alignment: bottom;
}

component DriveCard inherits Rectangle {
    in property <Drive> drive;
    callback open();

    height: 86px;
    border-radius: 10px;
    background: touch.has-hover ? #2b3038 : #23272d;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;

            Rectangle {
                width: 20px;
                background: transparent;

                KindIcon {
                    kind: "drive";
                    width: 20px;
                    height: 20px;
                }
            }

            Text {
                text: root.drive.label;
                color: #e9edf2;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }

        Text {
            text: root.drive.detail;
            color: #9aa1a9;
            font-size: 11px;
            overflow: elide;
        }

        Rectangle {
            height: 4px;
            border-radius: 2px;
            background: #343a42;

            Rectangle {
                width: parent.width * root.drive.usage;
                height: parent.height;
                border-radius: 2px;
                background: root.drive.usage > 0.9 ? #e06c6c : #5b9dff;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.open(); }
    }
}

component FileRow inherits Rectangle {
    in property <string> file-name;
    in property <string> meta;
    in property <string> date;
    in property <string> type-text;
    in property <string> label-text;
    in property <string> state-text;
    in property <bool> is-dir;
    in property <bool> selected;
    in property <bool> search-mode;
    in property <string> kind;
    callback select();
    callback activate();

    height: 38px;
    background: root.selected ? #2d3a4e : (row-touch.has-hover ? rgba(40, 46, 54, 0.72) : transparent);

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        spacing: 10px;

        Rectangle {
            width: 22px;
            background: transparent;

            KindIcon {
                kind: root.kind;
                width: 20px;
                height: 20px;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: root.file-name;
            color: root.is-dir ? #edf1f6 : #c9cfd6;
            font-size: 14px;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            width: 100px;
            text: root.label-text;
            color: #8b929a;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            visible: !root.search-mode;
        }

        Text {
            width: root.search-mode ? 300px : 160px;
            text: root.search-mode ? root.meta : root.date;
            color: #8b929a;
            font-size: 13px;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            width: 180px;
            text: root.type-text;
            color: #8b929a;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            visible: !root.search-mode;
        }

        Text {
            width: 90px;
            text: root.search-mode ? "" : root.meta;
            color: #8b929a;
            font-size: 13px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        Text {
            width: 70px;
            text: root.state-text;
            color: #8b929a;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            visible: !root.search-mode;
        }
    }

    row-touch := TouchArea {
        clicked => { root.select(); }
        double-clicked => { root.activate(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.select();
            }
        }
    }
}

component TabView inherits Rectangle {
    in property <string> title;
    in property <bool> active;
    callback selected();
    callback close();

    width: 172px;
    height: 32px;
    border-radius: 8px;
    background: root.active ? #2a2f36 : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 5px;
        spacing: 4px;

        Text {
            text: root.title;
            color: root.active ? #eef1f5 : #9aa1a9;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 5px;
            background: close-touch.has-hover ? #3d434b : transparent;

            Text {
                text: "×";
                color: #b3b9c0;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            close-touch := TouchArea {
                clicked => { root.close(); }
            }
        }
    }

    select-touch := TouchArea {
        clicked => { root.selected(); }
    }
}

component DialogButton inherits Rectangle {
    in property <string> label;
    in property <bool> accent: false;
    callback clicked();

    width: 92px;
    height: 30px;
    border-radius: 6px;
    background: root.accent ? (btn.has-hover ? #6cabff : #5b9dff) : (btn.has-hover ? #343b45 : #2a3038);

    Text {
        text: root.label;
        color: root.accent ? #0d1219 : #d7dee6;
        font-size: 12px;
        font-weight: root.accent ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    btn := TouchArea {
        clicked => { root.clicked(); }
    }
}

component BarButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> show-chevron: false;
    callback clicked();

    width: root.label == "" ? 32px : (root.show-chevron ? 112px : 96px);
    height: 30px;
    border-radius: 6px;
    background: bar.has-hover ? #2b3038 : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 7px;

        Image {
            source: root.icon;
            width: 16px;
            height: 16px;
        }

        Text {
            text: root.label;
            color: #d3dae2;
            font-size: 13px;
            vertical-alignment: center;
            visible: root.label != "";
        }

        Image {
            source: Icons.chevron;
            width: 12px;
            height: 12px;
            visible: root.show-chevron;
        }
    }

    bar := TouchArea {
        clicked => { root.clicked(); }
    }
}

component IconAction inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked();

    width: 32px;
    height: 30px;
    border-radius: 6px;
    background: root.enabled && ia.has-hover ? #2b3038 : transparent;

    Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        opacity: root.enabled ? 1 : 0.35;
    }

    ia := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

component BarDivider inherits Rectangle {
    width: 1px;
    height: 18px;
    background: #2f353d;
}


export component AppWindow inherits Window {
    in property <string> current-path;
    in property <[Row]> rows;
    in property <[Crumb]> crumbs;
    in property <[TabItem]> tabs;
    in property <[Drive]> drives;
    in property <[NavItem]> pinned;
    in property <int> active-tab;
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <bool> is-home;
    in property <int> selected-index: -1;
    in property <int> sort-key: 0;
    in property <int> sort-dir: 0;
    in property <int> item-count;
    in property <image> background-image;
    in property <bool> search-mode;
    in property <bool> has-selection;
    in property <bool> renaming;
    in-out property <string> rename-text;
    in-out property <string> search-text;

    callback select-tab(int);
    callback close-tab(int);
    callback new-tab();
    callback go-back();
    callback go-forward();
    callback go-up();
    callback go-home();
    callback refresh();
    callback open-crumb(string);
    callback open-row(int);
    callback select-row(int);
    callback sort-by(int);
    callback open-drive(string);
    callback toggle-fullscreen();
    callback search-changed(string);
    callback menu-open();
    callback menu-open-with();
    callback menu-copy-path();
    callback menu-rename();
    callback menu-delete();
    callback menu-new-folder();
    callback menu-properties();
    callback menu-terminal();
    callback confirm-rename();
    callback cancel-rename();

    title: "Raudo";
    icon: @image-url("../assets/icons/app.svg");
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 14px;
    // Slint derives the window's maximum size from the layout, which caps it
    // at the content's minimum width and makes the OS clip the window.
    max-width: 100000px;
    max-height: 100000px;
    background: #131519;

    Rectangle {
        background: #131519;
    }

    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: root.background-image;
        image-fit: cover;
        opacity: 0.42;
    }

    Rectangle {
        background: #0e1013;
        opacity: 0.55;
    }

    VerticalLayout {
        // ── Tab strip ────────────────────────────────────────────
        Rectangle {
            height: 40px;
            background: rgba(21, 23, 27, 0.84);

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 4px;

                for tab[i] in root.tabs : TabView {
                    title: tab.title;
                    active: i == root.active-tab;
                    selected => { root.select-tab(i); }
                    close => { root.close-tab(i); }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 6px;
                    background: plus-touch.has-hover ? #2a2f36 : transparent;

                    Text {
                        text: "+";
                        color: #c2c8cf;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    plus-touch := TouchArea {
                        clicked => { root.new-tab(); }
                    }
                }
            }
        }

        // ── Navigation bar ───────────────────────────────────────
        Rectangle {
            height: 46px;
            background: rgba(24, 26, 30, 0.82);

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 6px;

                ToolButton {
                    label: "←";
                    enabled: root.can-back;
                    clicked => { root.go-back(); }
                }

                ToolButton {
                    label: "→";
                    enabled: root.can-forward;
                    clicked => { root.go-forward(); }
                }

                ToolButton {
                    label: "↑";
                    enabled: !root.is-home;
                    clicked => { root.go-up(); }
                }

                ToolButton {
                    icon: Icons.home;
                    has-icon: true;
                    clicked => { root.go-home(); }
                }

                Rectangle {
                    height: 30px;
                    horizontal-stretch: 1;
                    min-width: 90px;
                    border-radius: 8px;
                    background: #23272d;
                    clip: true;

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: transparent;
                        clip: true;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 2px;
                            alignment: start;

                            Text {
                                text: root.is-home ? "Inicio" : "";
                                color: #d8dde3;
                                font-size: 13px;
                                vertical-alignment: center;
                            }

                            if !root.is-home : HorizontalLayout {
                                horizontal-stretch: 0;

                                for crumb in root.crumbs : HorizontalLayout {
                                    horizontal-stretch: 0;

                                    Text {
                                        text: "›";
                                        color: #6d747c;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 0;
                                    }

                                    Rectangle {
                                        height: 24px;
                                        horizontal-stretch: 0;
                                        border-radius: 5px;
                                        background: crumb-touch.has-hover ? #333941 : transparent;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;

                                            Text {
                                                text: crumb.name;
                                                color: #d8dde3;
                                                font-size: 13px;
                                                vertical-alignment: center;
                                            }
                                        }

                                        crumb-touch := TouchArea {
                                            clicked => { root.open-crumb(crumb.value); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    width: 220px;
                    height: 30px;
                    border-radius: 8px;
                    background: #23272d;

                    TextInput {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text <=> root.search-text;
                        color: #d8dde3;
                        font-size: 12px;
                        vertical-alignment: center;
                        edited => { root.search-changed(self.text); }
                    }

                    if root.search-text == "" : Text {
                        x: 10px;
                        text: "Buscar";
                        color: #767d85;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                ToolButton {
                    icon: Icons.refresh;
                    has-icon: true;
                    clicked => { root.refresh(); }
                }
            }
        }

        // ── Action bar ───────────────────────────────────────────
        Rectangle {
            height: 44px;
            background: rgba(22, 24, 28, 0.62);

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 12px;
                spacing: 2px;

                BarButton {
                    icon: Icons.home;
                    label: "Inicio";
                    clicked => { root.go-home(); }
                }

                BarDivider {}

                BarButton {
                    icon: Icons.plus;
                    label: "Nuevo";
                    show-chevron: true;
                    clicked => { root.menu-new-folder(); }
                }

                BarDivider {}

                IconAction {
                    icon: Icons.pencil;
                    enabled: root.has-selection;
                    clicked => { root.menu-rename(); }
                }

                IconAction {
                    icon: Icons.copy;
                    enabled: root.has-selection;
                    clicked => { root.menu-copy-path(); }
                }

                IconAction {
                    icon: Icons.trash;
                    enabled: root.has-selection;
                    clicked => { root.menu-delete(); }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                IconAction {
                    icon: Icons.refresh;
                    clicked => { root.refresh(); }
                }
            }
        }

        HorizontalLayout {
            // ── Sidebar ──────────────────────────────────────────
            Rectangle {
                width: 232px;
                background: rgba(24, 26, 30, 0.86);

                ScrollView {
                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 2px;

                        NavEntry {
                            label: "Inicio";
                            kind: "home";
                            active: root.is-home;
                            clicked => { root.go-home(); }
                        }

                        SectionLabel {
                            text: "ANCLADOS";
                        }

                        for item in root.pinned : NavEntry {
                            label: item.label;
                            kind: item.kind;
                            active: root.current-path == item.path;
                            clicked => { root.open-drive(item.path); }
                        }

                        SectionLabel {
                            text: "UNIDADES DE DISCO";
                        }

                        for drive in root.drives : NavEntry {
                            label: drive.letter + "  " + drive.label;
                            kind: "drive";
                            active: root.current-path == drive.root;
                            clicked => { root.open-drive(drive.root); }
                        }
                    }
                }
            }

            // ── Content ──────────────────────────────────────────
            Rectangle {
                background: transparent;

                ContextMenuArea {
                    Menu {
                        MenuItem {
                            title: "Abrir";
                            enabled: root.has-selection;
                            activated => { root.menu-open(); }
                        }
                        MenuItem {
                            title: "Abrir con...";
                            enabled: root.has-selection;
                            activated => { root.menu-open-with(); }
                        }
                        MenuSeparator {}
                        MenuItem {
                            title: "Copiar ruta";
                            enabled: root.has-selection;
                            activated => { root.menu-copy-path(); }
                        }
                        MenuItem {
                            title: "Renombrar";
                            enabled: root.has-selection;
                            activated => { root.menu-rename(); }
                        }
                        MenuItem {
                            title: "Eliminar";
                            enabled: root.has-selection;
                            activated => { root.menu-delete(); }
                        }
                        MenuSeparator {}
                        MenuItem {
                            title: "Nueva carpeta";
                            activated => { root.menu-new-folder(); }
                        }
                        MenuItem {
                            title: "Abrir en terminal";
                            activated => { root.menu-terminal(); }
                        }
                        MenuItem {
                            title: "Propiedades";
                            activated => { root.menu-properties(); }
                        }
                        MenuItem {
                            title: "Refrescar";
                            activated => { root.refresh(); }
                        }
                    }

                    VerticalLayout {
                        if root.is-home : VerticalLayout {
                    padding: 24px;
                    spacing: 12px;

                    Text {
                        text: "Inicio";
                        color: #f2f4f7;
                        font-size: 24px;
                        font-weight: 600;
                        height: 34px;
                        vertical-stretch: 0;
                    }

                    Text {
                        text: "Acceso rápido";
                        color: #9aa1a9;
                        font-size: 13px;
                        height: 20px;
                        vertical-stretch: 0;
                    }

                    HorizontalLayout {
                        height: 88px;
                        vertical-stretch: 0;
                        spacing: 12px;

                        for drive in root.drives : DriveCard {
                            drive: drive;
                            horizontal-stretch: 1;
                            open => { root.open-drive(drive.root); }
                        }
                    }

                    Text {
                        text: "Ubicaciones de red";
                        color: #9aa1a9;
                        font-size: 13px;
                        height: 28px;
                        vertical-stretch: 0;
                        vertical-alignment: bottom;
                    }

                    Rectangle {
                        height: 46px;
                        vertical-stretch: 0;
                        border-radius: 8px;
                        background: #1e2228;

                        HorizontalLayout {
                            padding-left: 14px;

                            Text {
                                text: "No hay ubicaciones de red configuradas.";
                                color: #7d848c;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: transparent;
                    }
                }

                if !root.is-home : VerticalLayout {
                    Rectangle {
                        height: 30px;
                        background: rgba(24, 26, 30, 0.72);

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 16px;
                            spacing: 10px;

                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;

                                Text {
                                    text: root.sort-key == 0 ? (root.sort-dir == 0 ? "Nombre ↑" : "Nombre ↓") : "Nombre";
                                    color: root.sort-key == 0 ? #a8c6f5 : #8b929a;
                                    font-size: 12px;
                                    width: parent.width;
                                    horizontal-alignment: left;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    clicked => { root.sort-by(0); }
                                }
                            }

                            Rectangle {
                                width: 100px;
                                background: transparent;
                                visible: !root.search-mode;

                                Text {
                                    text: "Etiqueta";
                                    color: #8b929a;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                width: root.search-mode ? 300px : 160px;
                                background: transparent;

                                Text {
                                    text: root.search-mode ? "Ubicación" : (root.sort-key == 2 ? (root.sort-dir == 0 ? "Fecha de modificación ↑" : "Fecha de modificación ↓") : "Fecha de modificación");
                                    color: root.sort-key == 2 && !root.search-mode ? #a8c6f5 : #8b929a;
                                    font-size: 12px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                TouchArea {
                                    clicked => { root.sort-by(2); }
                                }
                            }

                            Rectangle {
                                width: 180px;
                                background: transparent;
                                visible: !root.search-mode;

                                Text {
                                    text: "Tipo";
                                    color: #8b929a;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                width: 90px;
                                background: transparent;
                                visible: !root.search-mode;

                                Text {
                                    text: root.sort-key == 1 ? (root.sort-dir == 0 ? "Tamaño ↑" : "Tamaño ↓") : "Tamaño";
                                    color: root.sort-key == 1 ? #a8c6f5 : #8b929a;
                                    font-size: 12px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    clicked => { root.sort-by(1); }
                                }
                            }

                            Rectangle {
                                width: 70px;
                                background: transparent;
                                visible: !root.search-mode;

                                Text {
                                    text: "Estado";
                                    color: #8b929a;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    if root.rows.length == 0 : Rectangle {
                        background: transparent;

                        Text {
                            text: "Carpeta vacía";
                            color: #5f666e;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    ListView {
                        for row[i] in root.rows : FileRow {
                            file-name: row.name;
                            meta: row.meta;
                            date: row.date;
                            type-text: row.type-text;
                            label-text: row.label-text;
                            state-text: row.state-text;
                            is-dir: row.is-dir;
                            kind: row.kind;
                            selected: i == root.selected-index;
                            search-mode: root.search-mode;
                            select => { root.select-row(i); }
                            activate => { root.open-row(i); }
                        }
                    }

                    Rectangle {
                        height: 26px;
                        background: #1b1e22;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 16px;

                            Text {
                                text: root.item-count + " elementos";
                                color: #767d85;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }
                        }
                    }
                }
            }
        }
    }

    if root.renaming : Rectangle {
        background: #06080b;
        opacity: 0.55;
    }

    if root.renaming : Rectangle {
        width: 380px;
        height: 136px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 10px;
        background: #23272d;
        border-width: 1px;
        border-color: #303843;

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            Text {
                text: "Renombrar";
                color: #eef1f5;
                font-size: 14px;
                height: 20px;
                vertical-stretch: 0;
                vertical-alignment: center;
            }

            Rectangle {
                height: 32px;
                vertical-stretch: 0;
                border-radius: 6px;
                background: #1a1e24;

                TextInput {
                    x: 10px;
                    width: parent.width - 20px;
                    height: parent.height;
                    text <=> root.rename-text;
                    color: #e9edf2;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                height: 30px;
                vertical-stretch: 0;
                alignment: end;
                spacing: 8px;

                DialogButton {
                    label: "Cancelar";
                    clicked => { root.cancel-rename(); }
                }

                DialogButton {
                    label: "Aceptar";
                    accent: true;
                    clicked => { root.confirm-rename(); }
                }
            }
        }
    }
}
