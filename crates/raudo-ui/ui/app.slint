// Raudo — shell layout: tab strip, navigation bar, sidebar, home and list.

import { ListView, ScrollView } from "std-widgets.slint";

global Icons {
    out property <image> folder: @image-url("../assets/icons/folder.svg");
    out property <image> file: @image-url("../assets/icons/file.svg");
    out property <image> exe: @image-url("../assets/icons/exe.svg");
    out property <image> image: @image-url("../assets/icons/image.svg");
    out property <image> audio: @image-url("../assets/icons/audio.svg");
    out property <image> video: @image-url("../assets/icons/video.svg");
    out property <image> archive: @image-url("../assets/icons/archive.svg");
    out property <image> code: @image-url("../assets/icons/code.svg");
    out property <image> drive: @image-url("../assets/icons/drive.svg");
    out property <image> home: @image-url("../assets/icons/home.svg");
    out property <image> download: @image-url("../assets/icons/download.svg");
    out property <image> document: @image-url("../assets/icons/document.svg");
    out property <image> refresh: @image-url("../assets/icons/refresh.svg");
    out property <image> expand: @image-url("../assets/icons/expand.svg");
}

component KindIcon inherits Image {
    in property <string> kind;
    width: 18px;
    height: 18px;
    image-fit: contain;
    source: kind == "folder" ? Icons.folder
        : kind == "drive" ? Icons.drive
        : kind == "home" ? Icons.home
        : kind == "download" ? Icons.download
        : kind == "document" ? Icons.document
        : kind == "image" ? Icons.image
        : kind == "audio" ? Icons.audio
        : kind == "video" ? Icons.video
        : kind == "archive" ? Icons.archive
        : kind == "code" ? Icons.code
        : kind == "exe" ? Icons.exe
        : Icons.file;
}

export struct Row {
    name: string,
    meta: string,
    date: string,
    is-dir: bool,
    path: string,
    kind: string,
}

export struct Crumb {
    name: string,
    value: string,
}

export struct TabItem {
    title: string,
}

export struct Drive {
    letter: string,
    label: string,
    detail: string,
    usage: float,
    root: string,
}

export struct NavItem {
    label: string,
    path: string,
    kind: string,
}

component ToolButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> enabled: true;
    callback clicked();

    width: 30px;
    height: 28px;
    border-radius: 6px;
    background: enabled && touch.has-hover ? #2f343b : transparent;

    KindIcon {
        kind: "";
        source: root.icon;
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        opacity: root.enabled ? 1 : 0.4;
        visible: root.has-icon;
    }

    Text {
        text: root.label;
        color: root.enabled ? #d6dbe1 : #5a6068;
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
        visible: !root.has-icon;
    }

    touch := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

component NavEntry inherits Rectangle {
    in property <string> label;
    in property <string> kind;
    in property <bool> active;
    callback clicked();

    height: 30px;
    border-radius: 6px;
    background: touch.has-hover ? #2a2f36 : (root.active ? #2d3542 : transparent);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;

        Rectangle {
            width: 3px;
            height: 14px;
            border-radius: 2px;
            background: root.active ? #5b9dff : transparent;
        }

        KindIcon {
            kind: root.kind;
            width: 16px;
            height: 16px;
        }

        Text {
            text: root.label;
            color: root.active ? #eef1f5 : #c2c8cf;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SectionLabel inherits Text {
    color: #7d848c;
    font-size: 11px;
    letter-spacing: 0.6px;
    height: 26px;
    vertical-alignment: bottom;
}

component DriveCard inherits Rectangle {
    in property <Drive> drive;
    callback open();

    height: 86px;
    border-radius: 10px;
    background: touch.has-hover ? #2b3038 : #23272d;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;

            KindIcon {
                kind: "drive";
                width: 20px;
                height: 20px;
            }

            Text {
                text: root.drive.label;
                color: #e9edf2;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }

        Text {
            text: root.drive.detail;
            color: #9aa1a9;
            font-size: 11px;
            overflow: elide;
        }

        Rectangle {
            height: 4px;
            border-radius: 2px;
            background: #343a42;

            Rectangle {
                width: parent.width * root.drive.usage;
                height: parent.height;
                border-radius: 2px;
                background: root.drive.usage > 0.9 ? #e06c6c : #5b9dff;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.open(); }
    }
}

component FileRow inherits Rectangle {
    in property <string> file-name;
    in property <string> meta;
    in property <string> date;
    in property <bool> is-dir;
    in property <bool> selected;
    in property <bool> search-mode;
    in property <string> kind;
    callback select();
    callback activate();

    height: 27px;
    background: root.selected ? #2d3a4e : (row-touch.has-hover ? #22262c : transparent);

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        spacing: 10px;

        KindIcon {
            kind: root.kind;
            width: 18px;
            height: 18px;
        }

        Text {
            text: root.file-name;
            color: root.is-dir ? #edf1f6 : #c9cfd6;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            width: root.search-mode ? 330px : 86px;
            text: root.meta;
            color: #8b929a;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            width: 132px;
            text: root.date;
            color: #7d848c;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    row-touch := TouchArea {
        clicked => { root.select(); }
        double-clicked => { root.activate(); }
    }
}

component TabView inherits Rectangle {
    in property <string> title;
    in property <bool> active;
    callback selected();
    callback close();

    width: 172px;
    height: 32px;
    border-radius: 8px;
    background: root.active ? #2a2f36 : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 5px;
        spacing: 4px;

        Text {
            text: root.title;
            color: root.active ? #eef1f5 : #9aa1a9;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 5px;
            background: close-touch.has-hover ? #3d434b : transparent;

            Text {
                text: "×";
                color: #b3b9c0;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            close-touch := TouchArea {
                clicked => { root.close(); }
            }
        }
    }

    select-touch := TouchArea {
        clicked => { root.selected(); }
    }
}

export component AppWindow inherits Window {
    in property <string> current-path;
    in property <[Row]> rows;
    in property <[Crumb]> crumbs;
    in property <[TabItem]> tabs;
    in property <[Drive]> drives;
    in property <[NavItem]> pinned;
    in property <int> active-tab;
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <bool> is-home;
    in property <int> selected-index: -1;
    in property <int> sort-key: 0;
    in property <int> sort-dir: 0;
    in property <int> item-count;
    in property <image> background-image;
    in property <bool> search-mode;
    in-out property <string> search-text;

    callback select-tab(int);
    callback close-tab(int);
    callback new-tab();
    callback go-back();
    callback go-forward();
    callback go-up();
    callback go-home();
    callback refresh();
    callback open-crumb(string);
    callback open-row(int);
    callback select-row(int);
    callback sort-by(int);
    callback open-drive(string);
    callback toggle-fullscreen();
    callback search-changed(string);

    title: "Raudo";
    icon: @image-url("../assets/icons/app.svg");
    background: #131519;

    Rectangle {
        background: #131519;
    }

    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: root.background-image;
        image-fit: cover;
        opacity: 0.42;
    }

    Rectangle {
        background: #0e1013;
        opacity: 0.55;
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;

        // ── Tab strip ────────────────────────────────────────────
        Rectangle {
            height: 40px;
            background: #15171b;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 4px;

                for tab[i] in root.tabs : TabView {
                    title: tab.title;
                    active: i == root.active-tab;
                    selected => { root.select-tab(i); }
                    close => { root.close-tab(i); }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 6px;
                    background: plus-touch.has-hover ? #2a2f36 : transparent;

                    Text {
                        text: "+";
                        color: #c2c8cf;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    plus-touch := TouchArea {
                        clicked => { root.new-tab(); }
                    }
                }
            }
        }

        // ── Navigation bar ───────────────────────────────────────
        Rectangle {
            height: 46px;
            background: #1a1c20;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 6px;

                ToolButton {
                    label: "←";
                    enabled: root.can-back;
                    clicked => { root.go-back(); }
                }

                ToolButton {
                    label: "→";
                    enabled: root.can-forward;
                    clicked => { root.go-forward(); }
                }

                ToolButton {
                    label: "↑";
                    enabled: !root.is-home;
                    clicked => { root.go-up(); }
                }

                ToolButton {
                    icon: Icons.home;
                    has-icon: true;
                    clicked => { root.go-home(); }
                }

                Rectangle {
                    height: 30px;
                    horizontal-stretch: 1;
                    min-width: 90px;
                    border-radius: 8px;
                    background: #23272d;
                    clip: true;

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: transparent;
                        clip: true;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 2px;
                            alignment: start;

                            Text {
                                text: root.is-home ? "Inicio" : "";
                                color: #d8dde3;
                                font-size: 13px;
                                vertical-alignment: center;
                            }

                            if !root.is-home : HorizontalLayout {
                                horizontal-stretch: 0;

                                for crumb in root.crumbs : HorizontalLayout {
                                    horizontal-stretch: 0;

                                    Text {
                                        text: "›";
                                        color: #6d747c;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 0;
                                    }

                                    Rectangle {
                                        height: 24px;
                                        horizontal-stretch: 0;
                                        border-radius: 5px;
                                        background: crumb-touch.has-hover ? #333941 : transparent;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;

                                            Text {
                                                text: crumb.name;
                                                color: #d8dde3;
                                                font-size: 13px;
                                                vertical-alignment: center;
                                            }
                                        }

                                        crumb-touch := TouchArea {
                                            clicked => { root.open-crumb(crumb.value); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    width: 220px;
                    height: 30px;
                    border-radius: 8px;
                    background: #23272d;

                    TextInput {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text <=> root.search-text;
                        color: #d8dde3;
                        font-size: 12px;
                        vertical-alignment: center;
                        edited => { root.search-changed(self.text); }
                    }

                    if root.search-text == "" : Text {
                        x: 10px;
                        text: "Buscar";
                        color: #767d85;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                ToolButton {
                    icon: Icons.refresh;
                    has-icon: true;
                    clicked => { root.refresh(); }
                }

                ToolButton {
                    icon: Icons.expand;
                    has-icon: true;
                    clicked => { root.toggle-fullscreen(); }
                }
            }
        }

        HorizontalLayout {
            // ── Sidebar ──────────────────────────────────────────
            Rectangle {
                width: 232px;
                background: #191b1f;

                ScrollView {
                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 2px;

                        NavEntry {
                            label: "Inicio";
                            kind: "home";
                            active: root.is-home;
                            clicked => { root.go-home(); }
                        }

                        SectionLabel {
                            text: "ANCLADOS";
                        }

                        for item in root.pinned : NavEntry {
                            label: item.label;
                            kind: item.kind;
                            active: root.current-path == item.path;
                            clicked => { root.open-drive(item.path); }
                        }

                        SectionLabel {
                            text: "UNIDADES DE DISCO";
                        }

                        for drive in root.drives : NavEntry {
                            label: drive.letter + "  " + drive.label;
                            kind: "drive";
                            active: root.current-path == drive.root;
                            clicked => { root.open-drive(drive.root); }
                        }
                    }
                }
            }

            // ── Content ──────────────────────────────────────────
            Rectangle {
                background: transparent;

                if root.is-home : VerticalLayout {
                    padding: 24px;
                    spacing: 12px;

                    Text {
                        text: "Inicio";
                        color: #f2f4f7;
                        font-size: 24px;
                        font-weight: 600;
                        height: 34px;
                        vertical-stretch: 0;
                    }

                    Text {
                        text: "Acceso rápido";
                        color: #9aa1a9;
                        font-size: 13px;
                        height: 20px;
                        vertical-stretch: 0;
                    }

                    HorizontalLayout {
                        height: 88px;
                        vertical-stretch: 0;
                        spacing: 12px;

                        for drive in root.drives : DriveCard {
                            drive: drive;
                            horizontal-stretch: 1;
                            open => { root.open-drive(drive.root); }
                        }
                    }

                    Text {
                        text: "Ubicaciones de red";
                        color: #9aa1a9;
                        font-size: 13px;
                        height: 28px;
                        vertical-stretch: 0;
                        vertical-alignment: bottom;
                    }

                    Rectangle {
                        height: 46px;
                        vertical-stretch: 0;
                        border-radius: 8px;
                        background: #1e2228;

                        HorizontalLayout {
                            padding-left: 14px;

                            Text {
                                text: "No hay ubicaciones de red configuradas.";
                                color: #7d848c;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: transparent;
                    }
                }

                if !root.is-home : VerticalLayout {
                    Rectangle {
                        height: 30px;
                        background: #1b1e22;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 16px;
                            spacing: 10px;

                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;

                                Text {
                                    text: root.sort-key == 0 ? (root.sort-dir == 0 ? "Nombre ↑" : "Nombre ↓") : "Nombre";
                                    color: root.sort-key == 0 ? #a8c6f5 : #8b929a;
                                    font-size: 11px;
                                    width: parent.width;
                                    horizontal-alignment: left;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    clicked => { root.sort-by(0); }
                                }
                            }

                            Rectangle {
                                width: root.search-mode ? 330px : 86px;
                                background: transparent;

                                Text {
                                    text: root.search-mode ? "Ubicación" : (root.sort-key == 1 ? (root.sort-dir == 0 ? "Tamaño ↑" : "Tamaño ↓") : "Tamaño");
                                    color: root.sort-key == 1 && !root.search-mode ? #a8c6f5 : #8b929a;
                                    font-size: 11px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    clicked => { root.sort-by(1); }
                                }
                            }

                            Rectangle {
                                width: 132px;
                                background: transparent;

                                Text {
                                    text: root.sort-key == 2 ? (root.sort-dir == 0 ? "Fecha ↑" : "Fecha ↓") : "Fecha";
                                    color: root.sort-key == 2 ? #a8c6f5 : #8b929a;
                                    font-size: 11px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    clicked => { root.sort-by(2); }
                                }
                            }
                        }
                    }

                    if root.rows.length == 0 : Rectangle {
                        background: transparent;

                        Text {
                            text: "Carpeta vacía";
                            color: #5f666e;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    ListView {
                        for row[i] in root.rows : FileRow {
                            file-name: row.name;
                            meta: row.meta;
                            date: row.date;
                            is-dir: row.is-dir;
                            kind: row.kind;
                            selected: i == root.selected-index;
                            search-mode: root.search-mode;
                            select => { root.select-row(i); }
                            activate => { root.open-row(i); }
                        }
                    }

                    Rectangle {
                        height: 26px;
                        background: #1b1e22;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 16px;

                            Text {
                                text: root.item-count + " elementos";
                                color: #767d85;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
